{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/app/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/app/index.html",
          "/app/index.csr.html",
          "/app/manifest.webmanifest",
          "/app/*.css",
          "/app/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/app/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ],
        "urls": [
          "/api/media/favicon"
        ]
      }
    }
  ]
}